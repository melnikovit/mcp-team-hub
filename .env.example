# =============================================================================
# mcp-team-hub — environment template
# Copy to .env and replace every change-me / changeme before real deployment.
# Do not commit real secrets. Provider API tokens belong in the in-app vault.
# =============================================================================

# --- Postgres (one shared instance; schemas created by deploy/postgres) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mcp_admin

# --- Public entry (gateway) ---
GATEWAY_PORT=4300
APP_PUBLIC_URL=http://localhost:4300
CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300

# --- API auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Bootstrap admin (created on first start if missing)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme
BOOTSTRAP_ADMIN_NAME=Admin

# --- SMTP (optional). Empty = confirmation links logged / returned in API (dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# --- Orchestrator (Docker lifecycle API) ---
ORCHESTRATOR_API_TOKEN=change-me
REGISTRY_USER=
REGISTRY_PASSWORD=

# --- Gateway ↔ API internal calls ---
GATEWAY_INTERNAL_TOKEN=change-me
GATEWAY_URL=http://gateway:4300

# Gateway security middleware
GATEWAY_SECURITY_ENABLED=true
GATEWAY_REDACT_LOGS=true
GATEWAY_RATE_LIMIT_RPS=20
GATEWAY_RATE_LIMIT_BURST=40
GATEWAY_HEALTH_CHECK_ENABLED=true
GATEWAY_HEALTH_CHECK_INTERVAL=30s

# --- OIDC (optional). Leave OIDC_ISSUER empty to disable ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Admin stats rollups
STATS_ROLLUP_INTERVAL=24h

# --- Vault (mcp-secrets). Change before any real deploy ---
VAULT_MASTER_KEY=change-me-vault-master-key-32b-min
VAULT_SERVICE_TOKEN=change-me-vault-service-token

# --- Knowledge internal API ---
KNOWLEDGE_SERVICE_TOKEN=change-me-knowledge-service-token

# --- mcp-web-search (schema web_search) ---
WEB_SEARCH_ADMIN_LOGIN=admin
WEB_SEARCH_ADMIN_PASSWORD=changeme
WEB_SEARCH_ADMIN_JWT_SECRET=change-me-web-search-jwt
# Optional SearXNG connection for local compose (prefer vault in real deploys):
# WEB_SEARCH_CONNECTIONS=[{"name":"searx","provider":"searxng","base_url":"http://searxng:8080","default":true}]

# --- mcp-git ---
GIT_ADMIN_LOGIN=admin
GIT_ADMIN_PASSWORD=changeme
GIT_ADMIN_JWT_SECRET=change-me-git-jwt

# --- mcp-jira (user tokens only in vault) ---
JIRA_ADMIN_LOGIN=admin
JIRA_ADMIN_PASSWORD=changeme
JIRA_ADMIN_JWT_SECRET=change-me-jira-jwt

# --- mcp-notion (token only in vault as notion_token) ---
NOTION_BASE_URL=https://api.notion.com
NOTION_VERSION=2022-06-28

# --- mcp-confluence ---
CONFLUENCE_ADMIN_LOGIN=admin
CONFLUENCE_ADMIN_PASSWORD=changeme
CONFLUENCE_ADMIN_JWT_SECRET=change-me-confluence-jwt

# --- mcp-context ---
CONTEXT_ADMIN_LOGIN=admin
CONTEXT_ADMIN_PASSWORD=changeme
CONTEXT_ADMIN_JWT_SECRET=change-me-context-jwt

# --- Code indexing / Semgrep (optional host bind-mount, read-only) ---
# Example: CODEBASE_WORKSPACE_HOST_PATH=/Users/you/work
CODEBASE_WORKSPACE_HOST_PATH=
CODEBASE_MEMORY_INDEX_MAX_FILES=8000
CODEBASE_MEMORY_INDEX_MAX_FILE_BYTES=1500000
SEMGREP_DEFAULT_CONFIG=/opt/semgrep-rules
SEMGREP_TIMEOUT_SECONDS=90
SEMGREP_MAX_FINDINGS=50

# --- Knowledge crawl limits ---
KB_MAX_PAGES_PER_CRAWL=10000
KB_DEFAULT_PAGES_PER_CRAWL=3000
KB_MAX_DEPTH_PER_CRAWL=6
KB_DEFAULT_DEPTH_PER_CRAWL=3
KB_CRAWL_DELAY_MS=300
KB_MAX_DOCS_PER_COLLECTION=100000

# --- MCP upstream map (gateway /mcp/{id}/...) ---
MCP_UPSTREAMS=secrets=http://mcp-secrets:4112,web-search=http://mcp-web-search:4111,git=http://mcp-git:4101,jira=http://mcp-jira:4113,notion=http://mcp-notion:4114,confluence=http://mcp-confluence:4115,context=http://mcp-context:4110,figma=http://mcp-figma:4116,codebase-memory=http://mcp-codebase-memory:4117,semgrep=http://mcp-semgrep:4118,knowledge=http://mcp-knowledge:4119,repo-search=http://mcp-repo-search:4120,changelog=http://mcp-changelog:4121,ci=http://mcp-ci:4122,tracker=http://mcp-tracker:4123,openapi=http://mcp-openapi:4124,lighthouse=http://mcp-lighthouse:4125,bundle=http://mcp-bundle:4126,docker=http://mcp-docker:4127,database=http://mcp-database:4128,http-client=http://mcp-http-client:4129,secrets-scan=http://mcp-secrets-scan:4130,vuln=http://mcp-vuln:4131,playwright=http://mcp-playwright:4132,diagrams=http://mcp-diagrams:4133,kubernetes=http://mcp-kubernetes:4134,terraform=http://mcp-terraform:4135,ansible=http://mcp-ansible:4136,ssh=http://mcp-ssh:4137,slack=http://mcp-slack:4138,telegram=http://mcp-telegram:4139,email=http://mcp-email:4140,utils=http://mcp-utils:4141,fetch=http://mcp-fetch:4142,s3=http://mcp-s3:4143,memory-graph=http://mcp-memory-graph:4144,cloud=http://mcp-cloud:4145,monitoring=http://mcp-monitoring:4146,logs=http://mcp-logs:4147,office=http://mcp-office:4148
